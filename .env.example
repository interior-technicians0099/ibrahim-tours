# ==============================================================================
# IBRAHIM TOURS ZANZIBAR v3.0 — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this template to .env.local for local development.
# Configure all variables in the Vercel Project Settings for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string to Neon PostgreSQL with SSL enabled
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION SECURITY (NextAuth / Auth.js v5)
# ------------------------------------------------------------------------------
# Cryptographically secure secret key (Generate via: `openssl rand -base64 32`)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical URL of the deployment (localhost for dev, https://ibrahimtours.co.tz for prod)
NEXTAUTH_URL="https://ibrahimtours.co.tz"

# Public application base URL
NEXT_PUBLIC_APP_URL="https://ibrahimtours.co.tz"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL COMMUNICATIONS (Resend & WhatsApp)
# ------------------------------------------------------------------------------
# Resend API Key for sending booking request notifications & confirmations
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwx"

# Default notification sender address (must be verified domain in Resend)
RESEND_FROM_EMAIL="Ibrahim Tours <bookings@ibrahimtours.co.tz>"

# Operator WhatsApp dispatch number (international format without + or spaces)
OPERATOR_WHATSAPP_PHONE="255777000000"

# ------------------------------------------------------------------------------
# 4. MEDIA & CLOUD STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Cloudinary account credentials for tour photo gallery & license documents
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="ibrahim-tours-zanzibar"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 5. AUTOMATED MAINTENANCE & JOBS (Vercel Cron)
# ------------------------------------------------------------------------------
# Secret authorization bearer token used to trigger monthly settlement rollups
CRON_SECRET="your-long-random-cron-secret-key"

# ------------------------------------------------------------------------------
# 6. ERROR TRACKING & PERFORMANCE MONITORING (Sentry)
# ------------------------------------------------------------------------------
# Sentry DSN for client & server exception monitoring
NEXT_PUBLIC_SENTRY_DSN="https://your-public-key@o0.ingest.sentry.io/0000000"
SENTRY_DSN="https://your-public-key@o0.ingest.sentry.io/0000000"
